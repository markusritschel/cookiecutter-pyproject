{% raw -%}
# See https://just.systems/ for more information

[private]
default:
    @just --list

# Run ruff formatter, modifying files and fixing lint errors
format:
    uv run --group dev ruff format .
    uv run --group dev ruff check --fix .

# Run ruff linter without modifying files
lint:
    uv run --group dev ruff format --check .
    uv run --group dev ruff check .

# Run all the formatting, linting, and testing commands
qa:
    uv run --group dev ruff format .
    uv run --group dev ruff check --fix .
    uv run --group dev ruff check --select I --fix .
    uv run --group dev ty check .
    uv run --group dev pytest .

# Run all the tests, but allow for arguments to be passed
test *ARGS:
    @echo "Running with arg: {{ARGS}}"
    uv run --group test pytest {{ARGS}}

# Run all the tests, but on failure, drop into the debugger
pdb *ARGS:
    @echo "Running with arg: {{ARGS}}"
    uv run  --group test pytest --pdb --maxfail=10 --pdbcls=IPython.terminal.debugger:TerminalPdb {{ARGS}}

# Run coverage, and build to HTML
coverage:
    uv run --group test coverage run -m pytest .
    uv run --group test coverage report -m
    uv run --group test coverage html

# Build the project, useful for checking that packaging is correct
build:
    rm -rf build
    rm -rf dist
    uv build

VERSION := `grep -m1 '^version' pyproject.toml | sed -E 's/version = "(.*)"/\1/'`

# Print the current version of the project
version:
    @echo "Current version is {{VERSION}}"

{% endraw %}
# Compile the documentation
docs:
{%- if docs_engine|lower == 'sphinx' %}
    uv run --group docs sphinx-build -b html docs/ docs/_build/html
{%- elif docs_engine|lower == 'zensical' %}
    uv run --group docs zensical build
{%- elif docs_engine|lower == 'myst' %}
    cd docs && uv run --group docs myst build --html
{%- endif %}

# Serve the documentation with live reload
docs-serve:
{%- if docs_engine|lower == 'sphinx' %}
    uv run --group docs sphinx-autobuild --open-browser docs/ docs/_build/html
{%- elif docs_engine|lower == 'zensical' %}
    uv run --group docs zensical serve
{%- elif docs_engine|lower == 'myst' %}
    cd docs && uv run --group docs myst start
{%- endif %}

{% raw -%}
# Tag the current version in git and put to github
tag:
    @echo "Tagging version v{{VERSION}}"
    git tag -a v{{VERSION}} -m "Creating version v{{VERSION}}"
    git push origin v{{VERSION}}

# Create a GitHub release for the current version, triggering the PyPI upload
release:
    gh release create v{{VERSION}} --generate-notes

# Remove all build, test, coverage and Python artifacts
clean: clean-build clean-docs clean-pyc clean-test

# Remove build artifacts
clean-build:
    @echo "Cleaning build artifacts..."
    @rm -fr build/ dist/ .eggs/
    @find . -name '*.egg-info' -exec rm -fr {} +
    @find . -name '*.egg' -exec rm -f {} +

{% endraw %}
# Remove documentation build artifacts
clean-docs:
    @echo "Cleaning documentation build artifacts..."
{%- if docs_engine|lower == 'zensical' %}
    @rm -fr site/
{%- else %}
    @rm -fr docs/_build/ docs/api/
{%- endif %}
{% raw %}

# Remove Python file artifacts
clean-pyc:
    @echo "Cleaning Python file artifacts..."
    @find . -name '*.pyc' -exec rm -f {} +
    @find . -name '*.pyo' -exec rm -f {} +
    @find . -name '*~' -exec rm -f {} +
    @find . -name '__pycache__' -exec rm -fr {} +

# Remove test and coverage artifacts
clean-test:
    @echo "Cleaning test and coverage artifacts..."
    @rm -f .coverage
    @rm -fr htmlcov/ .pytest_cache

# Test github actions locally
test-gh-actions:
	@mkdir -p /tmp/artifacts
	act push --artifact-server-path /tmp/artifacts --container-options "--userns host" --action-offline-mode

# Publish to PyPI (manual alternative to GitHub Actions)
publish:
    uv build
    uv publish

# Set the user as required reviewer for the PyPI environment
set-pypi-review:
    #!/usr/bin/env bash
    set -euo pipefail
    repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
    user_id=$(gh api user --jq .id)
    gh api -X PUT "repos/$repo/environments/pypi" --input - <<EOF
    {"reviewers": [{"type": "User", "id": $user_id}], "prevent_self_review": false}
    EOF
{% endraw %}
{%- if is_research_project %}
{% raw %}

# ── Figure processing ───────────────────────────────────────────────────────────
# Conveniences for preparing figures for reports — delete them if your project
# does not produce figures. They require ImageMagick, and `crop-pdf` additionally
# requires `pdfcrop` from TeX Live.

IMAGEDIR := "reports/figures"
# ImageMagick 7 renamed `convert` to `magick` and warns on the old name.
MAGICK := `command -v magick || command -v convert || echo magick`

# Remove PNG files that were derived from a PDF or JPG of the same name
clear-images:
    @echo "Removing PNGs in {{IMAGEDIR}} that have a PDF or JPG parent"
    @find {{IMAGEDIR}} -type f \( -iname '*.pdf' -o -iname '*.jpg' -o -iname '*.jpeg' \) \
        | while read -r src; do rm -f "${src%.*}.png"; done

# Convert JPG and PDF figures to PNG, discarding conversions that compress badly
# NOTE: deliberate — the PNG is kept only if it is less than half the size of its
# source. That is the point for oversized vector PDFs, but a PNG rarely beats an
# already-compressed JPG by 2x, so JPG sources are usually converted and then
# discarded. Drop the size check below if you want to keep every conversion.
convert-images:
    @find {{IMAGEDIR}} -type f \( -iname '*.pdf' -o -iname '*.jpg' -o -iname '*.jpeg' \) \
        | while read -r src; do \
            out="${src%.*}.png"; \
            {{MAGICK}} -density 400 "$src" -resize 800x800 -quality 85% "$out" || continue; \
            echo "converted $src"; \
            if [ "$(stat -c%s "$src")" -lt "$(( $(stat -c%s "$out") * 2 ))" ]; then \
                echo "  discarding $out (less than 2x smaller than its source)"; rm -f "$out"; \
            fi; \
        done

# Crop whitespace from all PDF figures in place
crop-pdf:
    @echo "Cropping PDFs in {{IMAGEDIR}}"
    @find {{IMAGEDIR}} -type f -iname '*.pdf' \
        | while read -r f; do pdfcrop "$f" "$f" >/dev/null && echo "cropped $f"; done

# Crop PNG figures in place, leaving a white border
crop-png:
    @echo "Cropping PNGs in {{IMAGEDIR}}"
    @find {{IMAGEDIR}} -type f -iname '*.png' \
        | while read -r f; do {{MAGICK}} "$f" -trim -bordercolor White -border 25x25 "$f" && echo "cropped $f"; done

# Regenerate all figures: clear stale PNGs, crop sources, convert, crop results
figures: clear-images crop-pdf convert-images crop-png
    @echo "Finished creating figures"
{% endraw %}
{%- endif %}
